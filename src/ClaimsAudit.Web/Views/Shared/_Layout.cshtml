@{
    var controller = (string)ViewContext.RouteData.Values["controller"];
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Auditra</title>
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Cpath d='M16 2 4 6.5v8.2c0 7.4 5 13.4 12 15.3 7-1.9 12-7.9 12-15.3V6.5z' fill='%230b2545'/%3E%3Cpath d='m10.5 16 3.8 3.8 7.4-7.8' fill='none' stroke='%2334d1bf' stroke-width='3' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E" />
    <link href="~/Content/site.css" rel="stylesheet" />
</head>
<body>
    <header class="topbar">
        <div class="topbar-inner">
            <a class="brand" href="@Url.Action("Index", "Home")">
                <svg class="brand-mark" viewBox="0 0 32 32" aria-hidden="true">
                    <path d="M16 2 4 6.5v8.2c0 7.4 5 13.4 12 15.3 7-1.9 12-7.9 12-15.3V6.5z" fill="#1d4e89" />
                    <path d="M16 2v28c7-1.9 12-7.9 12-15.3V6.5z" fill="#163d6e" />
                    <path d="m10.5 16 3.8 3.8 7.4-7.8" fill="none" stroke="#34d1bf" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                <span class="brand-text">
                    <span class="brand-name">Auditra</span>
                    <span class="brand-sub">Claims Integrity</span>
                </span>
            </a>
            <nav class="mainnav">
                <a href="@Url.Action("Index", "Home")" class="@(controller == "Home" ? "active" : null)">Dashboard</a>
                <a href="@Url.Action("Index", "Claims")" class="@(controller == "Claims" ? "active" : null)">Claims</a>
            </nav>
            <div class="userbox">
                <span class="env-badge">Demo</span>
                <span class="avatar">CT</span>
                <span class="user-name">Compliance team</span>
            </div>
        </div>
    </header>
    <main class="container">
        @RenderBody()
    </main>
    <footer class="footer">
        <div class="footer-inner">
            <span>&copy; 2026 Auditra &middot; Claims Integrity</span>
            <span class="footer-note">Demo application. All patients, providers and claims are fictitious.</span>
        </div>
    </footer>
    <script src="https://code.jquery.com/jquery-1.12.4.min.js"></script>
    @RenderSection("scripts", required: false)
</body>
</html>
