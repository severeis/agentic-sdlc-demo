@model List<ClaimsAudit.Web.Models.Claim>
@{
    ViewBag.Title = "Claims";
    var flags = (Dictionary<int, List<AuditFlag>>)ViewBag.Flags;
    var sort = (string)ViewBag.Sort;
    var dir = (string)ViewBag.Dir;
    var from = (string)ViewBag.From;
    var to = (string)ViewBag.To;
}

@helper SortHeader(string key, string label, string sort, string dir, string from, string to)
{
    var nextDir = (sort == key && dir == "asc") ? "desc" : "asc";
    var arrow = "";
    if (sort == key)
    {
        arrow = dir == "asc" ? " ▲" : " ▼";
    }
    @Html.ActionLink(label, "Index", new { from = from, to = to, sort = key, dir = nextDir })<text>@arrow</text>
}

<h2>Claims</h2>

<form method="get" action="@Url.Action("Index")" class="filters">
    <label>From <input type="date" name="from" value="@ViewBag.From" /></label>
    <label>To <input type="date" name="to" value="@ViewBag.To" /></label>
    <button type="submit">Filter</button>
    <button type="button" onclick="location.href='@Url.Action("Index")'">Reset</button>
</form>

<div class="search">
    <input type="text" id="claim-search" placeholder="Search provider, patient or CPT code" data-url="@Url.Action("Search")" />
</div>

<table class="grid" id="claims-table">
    <thead>
        <tr>
            <th>@SortHeader("id", "Id", sort, dir, from, to)</th>
            <th>@SortHeader("date", "Date", sort, dir, from, to)</th>
            <th>@SortHeader("patient", "Patient", sort, dir, from, to)</th>
            <th>@SortHeader("provider", "Provider", sort, dir, from, to)</th>
            <th>@SortHeader("cpt", "CPT", sort, dir, from, to)</th>
            <th>@SortHeader("units", "Units", sort, dir, from, to)</th>
            <th>@SortHeader("billed", "Billed", sort, dir, from, to)</th>
            <th>@SortHeader("status", "Status", sort, dir, from, to)</th>
            <th>Flags</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var c in Model)
        {
            <tr>
                <td>@Html.ActionLink(c.Id.ToString(), "Details", new { id = c.Id })</td>
                <td>@c.ServiceDate.ToString("yyyy-MM-dd")</td>
                <td>@c.PatientId</td>
                <td>@c.ProviderName</td>
                <td>@c.CptCode</td>
                <td>@c.Units</td>
                <td>@c.BilledAmount.ToString("C")</td>
                <td>@c.Status</td>
                <td>
                    @foreach (var f in flags[c.Id])
                    {
                        <span class="flag" title="@f.Message">@f.Code</span>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

@section scripts {
    <script src="~/Scripts/claims.js"></script>
}
